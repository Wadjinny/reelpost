# Copy to .env and fill in. reelpost loads .env from the current directory.
# Do not commit .env. Tokens are secrets.

# Meta app from https://developers.facebook.com/apps/
REELPOST_APP_ID=
REELPOST_APP_SECRET=

# Facebook Login for Business configuration id. Leave empty to use the default permission list.
REELPOST_CONFIG_ID=

# Optional: skip `reelpost auth login` and pass a Page token directly.
REELPOST_PAGE_ID=
REELPOST_PAGE_NAME=
REELPOST_PAGE_TOKEN=
REELPOST_IG_USER_ID=
REELPOST_IG_USERNAME=

# Long-lived user token, if you already have one.
REELPOST_USER_TOKEN=

# Graph API version. v26.0 matches the current Reels publishing docs.
REELPOST_GRAPH_VERSION=v26.0

# YouTube Data API v3. Create an OAuth desktop client and add this redirect URI:
# http://localhost:53683/callback
# The secret is not saved. It is read from the environment when the login refreshes.
REELPOST_YOUTUBE_CLIENT_ID=
REELPOST_YOUTUBE_CLIENT_SECRET=
